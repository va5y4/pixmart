<section class='pricing'>
  <span class='pricing__label label'>{{ index.pricing.label }}</span>
  <h2 class='pricing__title'>{{ index.pricing.title }}</h2>
  <div class='pricing__list'>
    {% for plan in index.pricing_plans %}
      {% include '..\ui\membership-card.twig' with plan %}
    {% endfor %}
  </div>
</section>
