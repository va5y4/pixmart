<section class='hero'>
  <div class='hero__container'>
    <div class='hero__details'>
      <h1 class='hero__title'>
        {{ index.hero.title1 }}
        <br>
        {{ index.hero.title2 }}
        <br>
        {{ index.hero.title3 }}
        <span class='hero__highlight highlight'>{{ index.hero.highlight }}</span>
        {{ index.hero.title4 }}
      </h1>
      <p class='hero__description'>{{ index.hero.description }}</p>
      <div class='hero__actions'>
        <a class='hero__shop-button button' href='#test'>{{ index.hero.shop }}</a>
        <a class='hero__watch-button link' href='#test'
          ><img src='/src/assets/icons/cursor.svg' alt='watch about us icon'>{{ index.hero.watch }}
        </a>
      </div>
    </div>
    <div class='hero__images'>
      <div class='hero__image-card hero__image-card--main'>
        <img class='hero__image1' src='{{ index.hero.images[0].src }}' alt='{{ index.hero.images[0].alt }}'>
      </div>
      <div class='hero__image-card hero__image-card--top'>
        <img class='hero__image2' src='{{ index.hero.images[1].src }}' alt='{{ index.hero.images[1].alt }}'>
      </div>
      <div class='hero__image-card hero__image-card--bottom'>
        <img class='hero__image3' src='{{ index.hero.images[2].src }}' alt='{{ index.hero.images[2].alt }}'>
      </div>
      <img class='hero__icon hero__icon--top' src='/src/assets/images/hero-icon.svg' alt='design icon'>
      <img class='hero__icon hero__icon--bottom' src='/src/assets/images/hero-icon2.svg' alt='assets icon'>
    </div>
  </div>
</section>
