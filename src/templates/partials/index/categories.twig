<section class='categories'>
  <div class='categories__grid'>
    {% for item in index.cards %}
      <article class='categories__card'>
        <img src='{{item.src}}' alt='{{item.alt}}'>
        <span class='categories__card-title'>{{ item.title }}</span>
        <span class='categories__card-description'>{{ item.description1 }}</span>
        <span class='separator'>•</span>
        <span class='categories__card-description'>{{ item.description2 }}</span>
      </article>
    {% endfor %}
  </div>
  <div class='categories__details'>
    <span class='categories__label label'>{{ index.categories.label }}</span>
    <h2 class='categories__title'>{{ index.categories.title }}</h2>
    <p class='categories__description'>{{ index.categories.description }}</p>
    <a href='' class='categories__button button'>{{ index.categories.button }}</a>
  </div>
</section>
