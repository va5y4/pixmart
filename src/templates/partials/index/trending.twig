<section class='trending'>
  <div class='trending__header'>
    <div class='trending__header-wrapper'>
      <span class='trending__label label'>{{ index.trending.label }}</span>
      <h2 class='trending__title'>{{ index.trending.title }}</h2>
    </div>
    <div class='trending__nav-buttons'>
      <button type='button' aria-label='Navigation left button' class='trending__nav-left button'>left</button>
      <button type='button' aria-label='Navigation right button' class='trending__nav-right button'>right</button>
    </div>
  </div>
  <div class='trending__grid'>
    {% for item in index.trending.grid %}
      <div class='trending__grid-item'>
        <img src='{{item.src}}' alt='{{item.alt}}'>
        {% if item.trophy %}
          <span class='trending__trophy-icon'>⭐️</span>
        {% endif %}
        <div class='trending__meta'>
          <span class='trending__grid-title'>{{ item.title }}</span>
          <span class='trending__grid-price'>{{ item.price }}</span>
        </div>
        <div class='trending__tags'>
          <span class='trending__grid-description'>{{ item.description1 }}</span>
          <span class='separator'>•</span>
          <span class='trending__grid-description2'>{{ item.description2 }}</span>
        </div>
      </div>
    {% endfor %}
  </div>
</section>
