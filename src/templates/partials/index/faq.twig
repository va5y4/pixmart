<section class='faq'>
  <div class='faq__header'>
    <div class='faq__header-wrapper'>
      <span class='faq__label label'>{{ index.faq.label }}</span>
      <h2 class='faq__title'>{{ index.faq.title }}</h2>
    </div>
    <a href='' class='link'>{{ index.faq.button }}</a>
  </div>

  <div class='faq__list'>
    {% for item in index.faq_list %}
      <details class='faq-item'>
        <summary class='faq-item__question'>{{ item.question }}</summary>
        <p class='faq-item__answer'>{{ item.answer }}</p>
      </details>
    {% endfor %}
  </div>
</section>
