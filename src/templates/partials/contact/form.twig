<section class='form'>
  <form action=''>
    <div class='form__group'>
      <label for='name'>{{ contact.form.name }}</label>
      <input type='text' id='name' name='name' placeholder='Amelia Robert Johnson' required>
    </div>

    <div class='form__group'>
      <label for='email'>{{ contact.form.email }}</label>
      <input type='email' id='email' name='email' placeholder='amelia.robertjohnson@pixmart.com' required>
    </div>

    <div class='form__group'>
      <label for='subject'>{{ contact.form.subject }}</label>
      <select name='subject' id='subject'>
        <option value='general'>{{ contact.form.option }}</option>
      </select>
    </div>

    <div class='form__group'>
      <label for='message'>{{ contact.form.message }}</label>
      <textarea name='message' id='message' placeholder='Enter your message ...' required></textarea>
    </div>

    <div class='form__footer'>
      <div class='form__checkboxes'>
        {% for item in contact.form.checkboxes %}
          {% set checkbox_id = 'checkbox-' ~ loop.index %}
          <div class='form__checkbox'>
            <input type='checkbox' id='{{ checkbox_id }}' name='agreements[]' value='{{ item }}'>
            <label for='{{ checkbox_id }}'>{{ item }}</label>
          </div>
        {% endfor %}
      </div>
      <button type='submit' class='button form__button'>{{ contact.form.button }}</button>
    </div>
  </form>
</section>
