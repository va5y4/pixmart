<aside class='sidebar'>
  <form action=''>
    <div class='sidebar__categories'>
      <h4>{{ sidebar.categories.title }}</h4>
      {% for item in sidebar.categories.list %}
        <div class='sidebar__categories-item'>
          <input type='checkbox' id='category-checkbox' name='category'>
          <label for='category'>{{ item }}</label>
        </div>
      {% endfor %}

      <div class='sidebar__format'>
        <h4>{{ sidebar.format.title }}</h4>
        {% for item in sidebar.format.list %}
          <div class='sidebar__format-item'>
            <input type='radio' name='format' id='format-checkbox'>
            <label for='format'>{{ item }}</label>
          </div>
        {% endfor %}

        <div class='sidebar__style'>
          <h4>{{ sidebar.style.title }}</h4>
          {% for item in sidebar.style.list %}
            <div class='sidebar__style-item'>
              <input type='checkbox' name='style' id='style-toggle'>
              <label for='checkbox'>{{ item }}</label>
            </div>
          {% endfor %}
        </div>

        <button type='reset' class='sidebar__reset-button button'>{{ sidebar.reset }}</button>
      </div>
    </div>
  </form>
</aside>
