<header class='header'>
  <div class='container header__container'>
    <div class='header__left'>
      <a href='/' class='header__logo'>
        <img src='' alt='Pixmart logo'>
      </a>
      <nav class='header__nav'>
        <ul class='header__menu'>
          {% for item in common.nav %}
            <li class='header__menu-item'>
              <a href='{{ item.url }}'>{{ item.title }}</a>
            </li>
          {% endfor %}
        </ul>
      </nav>
    </div>
    <div class='header__right'>
      <form role='search' class='header__search' aria-label='Site search' autocomplete='off'>
        <label for='search-input' class='header__search-label visually-hidden'>Search</label>

        <input
          type='search'
          id='search-input'
          name='search'
          class='header__search-input'
          placeholder='Search for Digital Assets'
        >
      </form>
      <button type='button' class='header__cart cart' aria-label='Cart'>
        <img src='' alt='{{common.cart.alt}}'>
      </button>
    </div>
  </div>
</header>
