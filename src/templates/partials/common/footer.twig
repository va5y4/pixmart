<footer>
	<div class="footer__top">
		<a href="/" class="footer__logo">
			<img src="" alt="Pixmart logo">
		</a>
		<span class="footer__description">{{ footer.description }}</span>
		<section class="footer__nav">
			{% for section in footer.nav %}
			<span class="footer__title">{{ section.title }}</span>
			<ul>
				{% for item in section.links %}
				<li>{{ item }}</li>
				{% endfor %}
			</ul>
			{% endfor %}
		</section>
		<div class="footer__actions">
			<div class="footer__links">
				{% for social in footer.social %}
				<a href="{{ social.url }}"><img src="{{ social.icon }}" alt="{{ social.name }}"></a>
				{% endfor %}
			</div>
			<div class="footer__newsletter">
				<h4 class="footer__newsletter-title">{{ footer.newsletter.title|raw }}</h4>
				<form class="footer__newsletter-form" action="#" method="post" autocomplete="off">
					<label for="newsletter-email" class="visually-hidden">Email address</label>
					<div class="footer__newsletter-group">
						<input id="newsletter-email" name="email" type="email" class="footer__newsletter-input"
							placeholder="{{ footer.newsletter.placeholder }}" required>
						<button type="submit" class="footer__newsletter-btn">{{ footer.newsletter.button }}</button>
					</div>
				</form>
			</div>
		</div>
	</div>
</footer>