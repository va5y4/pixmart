<footer>
  <div class='footer-top'>
    <div class='footer-top__header'>
      <div class='footer-top__details'>
        <img src='/src/assets/icons/logo.svg' alt='{{common.footer.logo_alt}}'>
        <p class='footer-top__description'>{{ common.footer.description }}</p>
      </div>
      <div class='footer-top__nav'>
        {% for item in common.footer.nav %}
          <div class='footer-top__column'>
            <span>{{ item.title }}</span>
            <ul>
              {% for link in item.links %}
                <li>
                  <a href='{{ link.url }}'>{{ link.label }}</a>
                </li>
              {% endfor %}
            </ul>
          </div>
        {% endfor %}
      </div>
    </div>
    <div class='footer-top__actions'>
      {% for item in common.footer.socials %}
        <a href='#' aria-label='{{ item.alt }}'><img src='{{ item.src }}' alt='{{ item.alt }}'></a>
      {% endfor %}
      <form action='/subscribe' method='post'>
        <span>{{ common.footer.newsletter_title | raw }}</span>
        <label for='email' class='visually-hidden'>Email Address:</label>
        <input
          type='email'
          id='email'
          name='email'
          placeholder='Enter your email address...'
          required
          autocomplete='email'
        >
        <button type='submit' class='footer-top__subscribe button'>Subscribe</button>
      </form>
    </div>
  </div>
  <div class='footer-bottom'>
    <div class='footer-bottom__legal'>
      <ul>
        {% for item in common.footer.legal %}
          <li>
            <a href='{{item.href}}'>{{ item.name }}</a>
          </li>
          {% if not loop.last %}
            <li class='footer-bottom__separator'>|</li>
          {% endif %}
        {% endfor %}
      </ul>
    </div>
    <div class='footer-bottom__copyright'>Copyright &copy;{{ common.footer.copyright }}</div>
  </div>
</footer>
