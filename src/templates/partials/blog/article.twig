<article class='article'>
  <p class='article__paragraph'>{{ blog.article.paragraph }}</p>
  <ol class='article__list'>
    {% for item in blog.article.list %}
      <li class='article__item'>
        <h3 class='article__item-title'>{{ item.title }}</h3>
        <p class='article__item-paragraph'>{{ item.paragraph }}</p>
      </li>
      {% if loop.index == 2 %}
        <figure class='article__figure'>
          <img src='{{blog.article.figure.src}}' alt='{{blog.article.figure.alt}}'>
          <figcaption class='article__figure-caption'>
            <span>{{ blog.article.figure.caption }}</span>
            <a href='{{ blog.article.figure.href }}'>{{ blog.article.figure.link }}</a>
          </figcaption>
        </figure>
      {% endif %}
    {% endfor %}
  </ol>
  <div class='article__quote'>
    <img class='article__quote-icon' src='{{ blog.article.quote_icon.src }}' alt='{{ blog.article.quote_icon.alt }}'>
    <span class='article__quote-text'>{{ blog.article.quote }}</span>
  </div>
  <p class='article__epilog'>{{ blog.article.epilog }}</p>
</article>
