<aside class='sidebar'>
  {% include '../ui/author.twig' with { 'author': blog.author } %}

  <div class='sidebar__categories'>
    <h4 class='sidebar__categories-title'>{{ blog.categories_title }}</h4>
    <ul class='sidebar__categories-list'>
      {% for item in blog.categories %}
        <li class='sidebar__categories-item'>{{ item }}</li>
      {% endfor %}
    </ul>
  </div>

  <div class='sidebar__articles'>
    <h4 class='sidebar__articles-title'>{{ blog.articles.title }}</h4>
    <ul class='sidebar__articles-list'>
    {% for item in blog.articles.list %}
      <li class='sidebar__articles-item'>
        <span class='sidebar__articles-heading'>{{ item.heading }}</span>
        <time class='sidebar__articles-date' datetime='{{ item.datetime }}'>{{ item.date }}</time>
      </li>
      {% if not loop.last %}
        <hr class='sidebar__articles-separator'>
      {% endif %}
    {% endfor %}
    </ul>
  </div>
</aside>
